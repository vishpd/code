# Copy this file to .env and fill in your Zerodha Kite Connect credentials.
# The .env file is gitignored so your secrets stay out of version control.

# Permanent credentials from https://developers.kite.trade (Kite Connect app)
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Access token: regenerated every day. Leave blank on first run — the script
# runs an interactive login and writes the fresh token back here automatically.
KITE_ACCESS_TOKEN=
